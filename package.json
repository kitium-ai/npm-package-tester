{
  "name": "@kitiumai/npm-package-tester",
  "version": "3.1.1",
  "description": "AI-powered CLI testing tool for npm packages with Docker isolation, private package support, and automated test generation using Claude, GPT-4, Gemini",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "sideEffects": false,
  "bin": {
    "npm-package-tester": "dist/cli/index.js",
    "npt": "dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./domain": {
      "types": "./dist/domain/models/types.d.ts",
      "import": "./dist/domain/models/types.js",
      "default": "./dist/domain/models/types.js"
    },
    "./analyzer": {
      "types": "./dist/application/PackageAnalyzer.d.ts",
      "import": "./dist/application/PackageAnalyzer.js",
      "default": "./dist/application/PackageAnalyzer.js"
    },
    "./runner": {
      "types": "./dist/application/TestRunner.d.ts",
      "import": "./dist/application/TestRunner.js",
      "default": "./dist/application/TestRunner.js"
    },
    "./docker": {
      "types": "./dist/application/DockerManager.d.ts",
      "import": "./dist/application/DockerManager.js",
      "default": "./dist/application/DockerManager.js"
    },
    "./formatter": {
      "types": "./dist/formatters/ResultFormatter.d.ts",
      "import": "./dist/formatters/ResultFormatter.js",
      "default": "./dist/formatters/ResultFormatter.js"
    },
    "./ai": {
      "types": "./dist/ai/index.d.ts",
      "import": "./dist/ai/index.js",
      "default": "./dist/ai/index.js"
    },
    "./ai/provider": {
      "types": "./dist/ai/AIProvider.d.ts",
      "import": "./dist/ai/AIProvider.js",
      "default": "./dist/ai/AIProvider.js"
    },
    "./ai/scenario-generator": {
      "types": "./dist/ai/ScenarioGenerator.d.ts",
      "import": "./dist/ai/ScenarioGenerator.js",
      "default": "./dist/ai/ScenarioGenerator.js"
    },
    "./ai/library-scenario-generator": {
      "types": "./dist/ai/LibraryScenarioGenerator.d.ts",
      "import": "./dist/ai/LibraryScenarioGenerator.js",
      "default": "./dist/ai/LibraryScenarioGenerator.js"
    },
    "./utils": {
      "types": "./dist/utils/errors.d.ts",
      "import": "./dist/utils/errors.js",
      "default": "./dist/utils/errors.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "dist/**/*.js.map",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:integration": "vitest run --dir tests/integration",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "prepublishOnly": "npm run lint && npm run build",
    "changeset": "ensure-changeset && changeset",
    "version": "ensure-changeset && changeset version",
    "publish:set-token": "set-npm-token",
    "publish:setup": "set-npm-token",
    "publish:check": "npm whoami --registry https://registry.npmjs.org || npm login --registry https://registry.npmjs.org",
    "publish:login": "npm login --registry https://registry.npmjs.org",
    "publish:package": "pnpm run publish:check && pnpm publish --access public --no-git-checks --registry https://registry.npmjs.org",
    "publish:package:token": "pnpm run publish:setup && pnpm publish --access public --no-git-checks --registry https://registry.npmjs.org",
    "publish:package:otp": "pnpm run publish:check && pnpm publish --access public --no-git-checks --registry https://registry.npmjs.org --otp",
    "publish:dry-run": "pnpm publish --access public --no-git-checks --dry-run --registry https://registry.npmjs.org",
    "publish:dry-run:token": "pnpm run publish:setup && pnpm publish --access public --no-git-checks --dry-run --registry https://registry.npmjs.org",
    "release": "pnpm version && pnpm install --lockfile-only",
    "format:fix": "prettier --write ."
  },
  "keywords": [
    "npm",
    "npm-package",
    "npm-test",
    "npm-testing",
    "npm-validator",
    "package-testing",
    "package-validator",
    "package-quality",
    "testing",
    "test",
    "test-runner",
    "test-automation",
    "automated-testing",
    "cli",
    "cli-testing",
    "cli-tool",
    "command-line",
    "command-detection",
    "docker",
    "docker-testing",
    "docker-container",
    "docker-isolation",
    "dockerode",
    "containerization",
    "isolation",
    "sandbox",
    "automation",
    "ci-cd",
    "ci",
    "cd",
    "continuous-integration",
    "continuous-delivery",
    "github-actions",
    "gitlab-ci",
    "jenkins",
    "circleci",
    "travis-ci",
    "smoke-test",
    "integration-testing",
    "integration-test",
    "e2e-testing",
    "e2e",
    "end-to-end",
    "end-to-end-testing",
    "functional-testing",
    "acceptance-testing",
    "ai",
    "ai-testing",
    "ai-powered",
    "ai-assistant",
    "ai-tools",
    "artificial-intelligence",
    "claude",
    "claude-ai",
    "anthropic",
    "openai",
    "gpt",
    "gpt-4",
    "chatgpt",
    "gemini",
    "google-ai",
    "groq",
    "llm",
    "large-language-model",
    "machine-learning",
    "private-packages",
    "private-registry",
    "npm-registry",
    "registry",
    "scoped-packages",
    "npm-token",
    "authentication",
    "validation",
    "validator",
    "type-checking",
    "typescript",
    "typescript-testing",
    "javascript",
    "nodejs",
    "node",
    "node-modules",
    "library-testing",
    "exports",
    "export-detection",
    "ast",
    "babel",
    "jsdoc",
    "api-testing",
    "scenario-generation",
    "test-generation",
    "devtools",
    "dev-tools",
    "developer-tools",
    "developer-experience",
    "dx",
    "quality-assurance",
    "qa",
    "code-quality",
    "package-manager",
    "npm-ci",
    "pnpm",
    "yarn",
    "monorepo",
    "workspace",
    "version-testing",
    "compatibility",
    "cross-version",
    "matrix-testing",
    "publishing",
    "prepublish",
    "release",
    "semantic-versioning",
    "semver"
  ],
  "author": "KitiumAI",
  "license": "MIT",
  "homepage": "https://github.com/kitium-ai/npm-package-tester#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kitium-ai/npm-package-tester.git"
  },
  "bugs": {
    "url": "https://github.com/kitium-ai/npm-package-tester/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "dependencies": {
    "@babel/parser": "^7.23.6",
    "@babel/traverse": "^7.23.6",
    "@babel/types": "^7.23.6",
    "chalk": "^5.3.0",
    "commander": "^14.0.2",
    "dockerode": "^4.0.2",
    "execa": "^8.0.1",
    "ora": "^8.0.1",
    "semver": "^7.5.4",
    "typescript": "^5.6.0",
    "@kitiumai/logger": "^2.0.1",
    "@kitiumai/types": "^2.0.1",
    "@kitiumai/utils-ts": "^2.0.1",
    "@kitiumai/error": "^2.0.1"
  },
  "devDependencies": {
    "@kitiumai/config": "^2.0.1",
    "@kitiumai/lint": "^2.0.1",
    "@kitiumai/scripts": "^1.0.0",
    "@kitiumai/vitest-helpers": "^2.0.1",
    "@types/dockerode": "^3.3.23",
    "@types/node": "^24.10.1",
    "@types/semver": "^7.5.6",
    "@typescript-eslint/eslint-plugin": "^8.16.0",
    "@typescript-eslint/parser": "^8.16.0",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "prettier": "^3.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.0",
    "vitest": "^2.1.8",
    "@vitest/coverage-v8": "^2.1.8"
  }
}
