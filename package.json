{
  "name": "@kitiumai/npm-package-tester",
  "version": "2.0.0",
  "description": "AI-powered CLI testing tool for npm packages with Docker isolation, private package support, and automated test generation using Claude, GPT-4, Gemini",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "npm-package-tester": "dist/cli/index.js",
    "npt": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:integration": "vitest run --dir tests/integration",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "prepublishOnly": "npm run lint && npm run test && npm run build",
    "changeset": "changeset",
    "version": "changeset version",
    "publish:set-token": "set-npm-token",
    "publish:setup": "set-npm-token",
    "publish:check": "npm whoami --registry https://registry.npmjs.org || npm login --registry https://registry.npmjs.org",
    "publish:login": "npm login --registry https://registry.npmjs.org",
    "publish:package": "pnpm run publish:check && pnpm publish --access public --no-git-checks --registry https://registry.npmjs.org",
    "publish:package:token": "pnpm run publish:setup && pnpm publish --access public --no-git-checks --registry https://registry.npmjs.org",
    "publish:package:otp": "pnpm run publish:check && pnpm publish --access public --no-git-checks --registry https://registry.npmjs.org --otp",
    "publish:dry-run": "pnpm publish --access public --no-git-checks --dry-run --registry https://registry.npmjs.org",
    "publish:dry-run:token": "pnpm run publish:setup && pnpm publish --access public --no-git-checks --dry-run --registry https://registry.npmjs.org",
    "release": "pnpm version && pnpm install --lockfile-only",
    "format:fix": "prettier --write ."
  },
  "keywords": [
    "npm",
    "testing",
    "cli",
    "cli-testing",
    "npm-testing",
    "package-testing",
    "docker",
    "docker-testing",
    "automation",
    "ci-cd",
    "continuous-integration",
    "smoke-test",
    "integration-testing",
    "e2e-testing",
    "end-to-end",
    "ai",
    "ai-testing",
    "artificial-intelligence",
    "claude",
    "anthropic",
    "openai",
    "gpt-4",
    "gemini",
    "groq",
    "llm",
    "private-packages",
    "npm-registry",
    "scoped-packages",
    "command-detection",
    "validation",
    "test-automation",
    "typescript",
    "nodejs",
    "node"
  ],
  "author": "KitiumAI",
  "license": "MIT",
  "homepage": "https://github.com/kitium-ai/npm-package-tester#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kitium-ai/npm-package-tester.git"
  },
  "bugs": {
    "url": "https://github.com/kitium-ai/npm-package-tester/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "dependencies": {
    "@babel/parser": "^7.23.6",
    "@babel/traverse": "^7.23.6",
    "@babel/types": "^7.23.6",
    "chalk": "^5.3.0",
    "commander": "^14.0.2",
    "dockerode": "^4.0.2",
    "execa": "^8.0.1",
    "ora": "^8.0.1",
    "semver": "^7.5.4",
    "typescript": "^5.6.0",
    "@kitiumai/logger": "1.5.0",
    "@kitiumai/types": "^1.0.0",
    "@kitiumai/utils-ts": "^1.0.0"
  },
  "devDependencies": {
    "@kitiumai/config": "^1.0.2",
    "@kitiumai/lint": "^1.3.5",
    "@kitiumai/scripts": "^0.2.1",
    "@kitiumai/vitest-helpers": "^1.0.2",
    "@types/dockerode": "^3.3.23",
    "@types/node": "^24.10.1",
    "@types/semver": "^7.5.6",
    "@typescript-eslint/eslint-plugin": "^8.16.0",
    "@typescript-eslint/parser": "^8.16.0",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "prettier": "^3.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.0",
    "vitest": "^2.1.8",
    "@vitest/coverage-v8": "^2.1.8"
  }
}
